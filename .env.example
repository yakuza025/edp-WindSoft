# ═══════════════════════════════════════════════════════════════════
# WindSoft Monorepo — .env.example
# Copy to the appropriate sub-project's .env file, fill in real values.
# NEVER commit the real .env file.
# ═══════════════════════════════════════════════════════════════════

# ── Backend (edp-windsoft-api/.env) ─────────────────────────────
PORT=3021
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=edp_windsoft

# Generate with: openssl rand -base64 48
ADMIN_KEY=replace-with-a-strong-random-key

CORS_ORIGIN=http://localhost:5091
SITE_URL=https://windsoft.example

# ── Frontend (edp-windsoft-ui/.env) ─────────────────────────────
VITE_API_URL=http://localhost:3021/api/v1
VITE_APP_VERSION=1.0.0
